# Copy this file to .env and fill in real values. .env is git-ignored.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (XAMPP MariaDB default: user root, empty password)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/greenhands?charset=utf8mb4

# Separate database used by integration tests (tables are dropped between tests)
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/greenhands_test?charset=utf8mb4

# Seed script: credentials for the demo accounts created by `python seed.py`
SEED_ADMIN_PASSWORD=Admin#12345
SEED_VOLUNTEER_PASSWORD=Volunteer#12345
